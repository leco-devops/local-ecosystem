.DS_Store
__pycache__/
*.pyc
*.egg-info/

# Per-machine leco apps registered for LEco DevOps
config/leco-registry.yaml

# AI provider config — contains API keys, never commit
config/ai-providers.yaml

# Timestamped backups of the secret files above — the exact-path rules do not
# match a .bak-<stamp> suffix, so name them explicitly.
config/*.bak-*
config/*.bak
config/*.orig
config/*~
config/ui-credentials.yaml

# CI/CD pipelines — contains webhook secrets (HMAC needs the raw value), never commit
config/cicd-pipelines.yaml

# Git credentials for onboarding-from-Git (tokens / SSH keys), never commit
config/git-credentials.yaml

# Repositories cloned by the register wizard when the workspace parent is not
# mounted read-write (dashboard/git_source.py) — never repo content
hosting/app-sources/

# File transfer runtime secrets and SFTP public keys (local dev)
file-transfer/.env
file-transfer/keys/sftp/*.pub

# Per-machine hosted app manifests, overlays, and symlinks (generated by register wizard)
hosting/app-available/*/
!hosting/app-available/README.md
!hosting/app-available/.gitkeep

# Local TLS material
certs/*.pem
certs/*.key
certs/*-key.pem
# Timestamped backups from certs/generate-certs.sh (the .bak-<stamp> suffix escapes *.pem)
certs/*.bak-*

# MCP activity telemetry — per-machine runtime log, appended on every tool call.
# The catalog JSON beside it is shared state and stays tracked; this is not.
ecosystem-stack/config/generated/mcp-activity.jsonl

# Per-machine service start policies (the .example.json is the tracked template).
ecosystem-stack/config/service-default-policies.json

# Writable runtime Traefik dynamic fragment
hosting/traefik/dynamic.yml
# Copy of traefik/dynamic.yml created by ecosystem-stack/services/traefik.sh (not a symlink)
hosting/traefik/01-stack-core.yml
# Dev-stack routes regenerated by dashboard / dev_stack_routes.py (per machine)
hosting/traefik/20-dev-stacks.yml

# Per-machine selection recorded by ecosystem-stack/install-foundation.sh
ecosystem-stack/config/install-selection.env

# Cloud VM platform config (per machine)
config/leco-platform.yaml

# Per-machine dev stacks and platform runtime (generated by dashboard; not committed)
platform/*
!platform/.gitkeep
!platform/README.md
!platform/dev-stacks/
platform/dev-stacks/*
!platform/dev-stacks/.gitkeep
!platform/dev-stacks/README.md

# leco-cli wrapper logs (per-run JSONL emitted by tools/leco-cli.sh)
.leco-cli-logs/

# CI/CD run history (per-machine runtime state: deploy logs, commit SHAs, timings)
ecosystem-stack/config/generated/cicd-runs.jsonl
ecosystem-stack/config/generated/cicd-runs.jsonl.tmp

# RAG index over the repo's own docs (rebuilt on demand by dashboard/ai_corpus.py,
# ~1 MB, always derivable from the tracked markdown — never committed)
ecosystem-stack/config/generated/ai-rag-index.json
ecosystem-stack/config/generated/ai-rag-embeddings.json
ecosystem-stack/config/generated/ai-rag-*.tmp

/Backup

# project-atlas derived site — regenerable from the markdown with `atlas build`.
# The documents are the source of truth; committing 336 generated files would churn
# every doc diff and can never disagree with the sources without being rebuilt.
docs/_wiki/
.atlas/

# Local Python virtualenvs (MCP server stdio install; see docs/CONNECT_AI_AGENTS.md)
.venv/
venv/

# Social publishing kits — the LinkedIn article and group assets. Rendered PNGs beside
# their SVG sources, ~2 MB, produced with rsvg-convert and consumed by hand when posting.
# Nothing in the site or the docs links them, so the repository gains nothing by carrying
# them; each kit's README documents the re-render command.
assets/social/
